: "grammar", "tag": "L14 语法 · 正在进行", "front": "動詞て形います", "sub": "ミラーさんは今電話をかけています。", "back": "这一句型表示某一动作正在进行。", "detail": "ミラーさんは今電話をかけています。", "speak": "ミラーさんは今電話をかけています。"}, {"type": "grammar", "tag": "L14 语法 · 主动提议", "front": "動詞ます形ましょうか", "sub": "荷物を持ちましょうか。", "back": "「動詞ます形ましょうか」表示说话人主动提出为对方做某事。", "detail": "荷物を持ちましょうか。", "speak": "荷物を持ちましょうか。"}, {"type": "grammar", "tag": "L14 语法 · 现象主语", "front": "名詞が動詞ています", "sub": "雨が降っています。", "back": "把自己五官所感受到的某种现象直接说出来，或客观地传达某件事情时，主语用助词「が」表示。", "detail": "雨が降っています。", "speak": "雨が降っています。"}, {"type": "grammar", "tag": "L14 语法 · 开场表达", "front": "すみませんが", "sub": "すみませんが、塩を取ってください。", "back": "与别人搭话所用的「すみませんが」「失礼ですが」等表达方式中的「が」没有转折的意思，而是用来开启话题、连接后续请求的接续词。", "detail": "すみませんが、塩を取ってください。", "speak": "すみませんが、塩を取ってください。"}, {"type": "grammar", "tag": "L14 语法 · 出租车表达", "front": "みどり町までお願いします", "sub": "みどり町までお願いします。", "back": "乘坐出租车时，可以用「場所までお願いします」说明目的地。指示司机转弯、直行、停车时，可以使用「曲がってください」「行ってください", "detail": "みどり町までお願いします。", "speak": "みどり町までお願いします。"}], "sentence": [{"type": "sentence", "tag": "L14 例句 · 动词分类", "front": "書きます。", "sub": "I類動詞／II類動詞／III類動詞", "back": "写。", "detail": "句型: I類動詞／II類動詞／III類動詞", "speak": "書きます。"}, {"type": "sentence", "tag": "L14 例句 · 动词分类", "front": "飲みます。", "sub": "I類動詞／II類動詞／III類動詞", "back": "喝。", "detail": "句型: I類動詞／II類動詞／III類動詞", "speak": "飲みます。"}, {"type": "sentence", "tag": "L14 例句 · 动词分类", "front": "食べます。", "sub": "I類動詞／II類動詞／III類動詞", "back": "吃。", "detail": "句型: I類動詞／II類動詞／III類動詞", "speak": "食べます。"}, {"type": "sentence", "tag": "L14 例句 · 动词分类", "front": "見せます。", "sub": "I類動詞／II類動詞／III類動詞", "back": "给〜看。", "detail": "句型: I類動詞／II類動詞／III類動詞", "speak": "見せます。"}, {"type": "sentence", "tag": "L14 例句 · 动词分类", "front": "見ます。", "sub": "I類動詞／II類動詞／III類動詞", "back": "看。", "detail": "句型: I類動詞／II類動詞／III類動詞", "speak": "見ます。"}, {"type": "sentence", "tag": "L14 例句 · 动词分类", "front": "来ます。", "sub": "I類動詞／II類動詞／III類動詞", "back": "来。", "detail": "句型: I類動詞／II類動詞／III類動詞", "speak": "来ます。"}, {"type": "sentence", "tag": "L14 例句 · 动词分类",